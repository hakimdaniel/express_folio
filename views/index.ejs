	<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<style>
		body{
			padding: 30px 0;
		}
	</style>
</head>
<body>


<div class="hero bg-base-200 min-h-screen" style="background-color: inherit;">
  <div class="hero-content flex-col lg:flex-row" style="max-width:800px;margin:0 20px;">
    <img
      src="/images/my-photo.webp"
      class="max-w-sm rounded-lg shadow-2xl" width="300"
    />
    <div>
      <h1 style="color:white" class="text-5xl font-bold">Daniel Hakim</h1>
      <sub style="color:#fff;font-size: 22px">
      	<span style="font-size:17px;display: block;padding: 5px;"><i class="fa-solid fa-envelope"></i> d4nielhakim@gmail.com</span>
      	<span style="font-size:17px;display: block;padding: 5px;"><i class="fa-solid fa-phone"></i> +60169749725</span><br>
      	<span style="color:#1770ff">Engineering Student</span> •<br><span style="color:#ffc717">Electronic Industry Engineer</span> •<br><span style="color:#8425cc">Fullstacks Developer</span> •<br><span style="color:#3fcfd4">Cybersecurity Enthusiast</span></sub>
      <p class="py-6" style="color:#ddd">
        I’m interested in full-stack development and IoT engineering, and I spend most of my time building small, hands-on projects. I like exploring how web applications and hardware systems can work together to create practical solutions, while continuously improving my skills along the way.
      </p>
      <button class="btn btn-primary" onclick="my_modal_5.showModal()">Contact me</button>
		<dialog id="my_modal_5" class="modal modal-bottom sm:modal-middle">
		  <div class="modal-box">
		    <h3 class="text-lg font-bold" style="font-size:30px;margin-bottom: 12px;">Contact me</h3>
		    <hr>
		    <form method="post" action="/submit">
		    	<fieldset class="fieldset">
				  <legend class="fieldset-legend">What should i call you?</legend>
				  <input type="text" class="input" placeholder="Your name..." name="name" required/>
				</fieldset>
				<fieldset class="fieldset">
				  <legend class="fieldset-legend">Your email?</legend>
				  <input type="email" class="input" placeholder="Your email..." name="mail" required/>
				</fieldset>
				<fieldset class="fieldset">
				  <legend class="fieldset-legend">What's in your mind?</legend>
				  <textarea class="textarea" placeholder="Your message..." name="message"></textarea>
				</fieldset><br>
				<button class="btn btn-secondary">Submit</button>
		    </form>
		    <div class="modal-action">
		      <form method="dialog">
		        <!-- if there is a button in form, it will close the modal -->
		        <button class="btn">Close</button>
		      </form>
		    </div>
		  </div>
		</dialog>
    </div>
  </div>
</div>

</body>
